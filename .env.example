# ── Stream ───────────────────────────────────────────────────────────────────
STREAM_URL=https://video10.logicahost.com.br/tvcidade10/tvcidade10/playlist.m3u8
# Extra hosts the HLS proxy may contact (the stream's own host is always allowed).
# A leading dot matches subdomains. Example if segments live on another host:
# PROXY_ALLOWED_HOSTS=.logicahost.com.br,cdn.example.com
PROXY_ALLOWED_HOSTS=

# ── Groq (cloud ASR + translation — one key covers both) ─────────────────────
# Get a free key at https://console.groq.com/keys
# When set: ASR uses whisper-large-v3-turbo (~100-300 ms per segment on Groq's
# hardware vs. 3-10 s locally), translation uses a Groq LLM.
# When unset: falls back to local faster-whisper + NLLB (works, but slower).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GROQ_TRANSLATE_MODEL=openai/gpt-oss-20b   # LLM used for PT→ES translation

# ── Web server ───────────────────────────────────────────────────────────────
HOST=127.0.0.1        # use 0.0.0.0 only if you want other devices on your LAN to connect
PORT=8000
LOG_LEVEL=INFO

# ── Speech recognition — local faster-whisper (ignored when GROQ_API_KEY set) ─
WHISPER_MODEL=small   # tiny | base | small | medium | large-v3  (bigger = better, slower)
WHISPER_DEVICE=auto   # auto | cpu | cuda  (auto detects CUDA)
WHISPER_COMPUTE=auto  # auto | int8 (cpu) | float16 (cuda)
WHISPER_BEAM=1        # 1 = fastest; 2-5 slightly more accurate (use on GPU)
# WHISPER_PROMPT=Jornal da Cidade, Maldonado, Punta del Este   # names the channel uses

# ── Voice activity detection ─────────────────────────────────────────────────
VAD_THRESHOLD=0.5
VAD_MAX_SEGMENT_MS=5000   # lower = less latency, more mid-sentence cuts (was 8000)
VAD_SILENCE_MS=500
VAD_MIN_SPEECH_MS=500
VAD_PREROLL_MS=300

# ── Translation PT → ES ───────────────────────────────────────────────────────
# When GROQ_API_KEY is set, TRANSLATION_BACKEND defaults to "groq" automatically.
# Only set this explicitly if you want to force a specific backend.
ENABLE_TRANSLATION=true
# TRANSLATION_BACKEND=groq  # groq (default when GROQ_API_KEY set) | nllb | marian | llm
TRANSLATION_DEVICE=auto   # auto | cpu | cuda
# --- generic LLM backend (TRANSLATION_BACKEND=llm) ---
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ── GitHub upload configuration ───────────────────────────────────────────────
# Repository URL to use as the git remote, for example:
# https://github.com/your-user/your-repo.git
GITHUB-REPOSITORY=https://github.com/your-user/your-repo.git
# Personal Access Token with repo or contents:write permission
# Generate it at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
